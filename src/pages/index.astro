---
import { getCollection } from "astro:content"
import { Picture } from "astro:assets"
import Layout from "../layouts/Layout.astro"
import Name from "../components/Name.astro"
import websiteConfig from "../config/config"
import { links } from "../data/links"
import { skills } from "../data/skills"
import { getBgColors } from "../color/backgroundColor"
import AndroidIcon from "../icons/android.svg"
import GitHubIcon from "../icons/github.svg"
import XMarkIcon from "../icons/xmark.svg"
import ExternalIcon from "../icons/external.svg"

const projects = (await getCollection("projects"))
  .sort((a, b) => Number(a.id) - Number(b.id))
  .map((entry) => entry.data)

const linkBgColors = [
  "from-blue-800 to-cyan-500",
  "from-neutral-800 to-zinc-500",
  "from-green-800 to-emerald-500",
]
const skillPillBgColors = getBgColors(skills, "#5b21b6", "#d946ef")
const projectBgColors = getBgColors(projects, "#7f1d1d", "#ea580c")
---

<Layout
  title={websiteConfig.siteTitle}
  description={websiteConfig.siteDescription}
  og
>
  <main class="w-full px-6 py-12 sm:p-12 md:p-24 lg:p-36 justify-center items-center flex">
    <div class="w-full xl:w-[88rem]">
      <div class="animate-in fade-in slide-in-from-top-14 duration-1000">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-medium text-white mb-6 tracking-wide">
          <div class="hidden min-[440px]:block">Hello,</div>
          <div class="hidden min-[440px]:block">
            <span class="inline whitespace-pre">I'm </span>
            <Name />.
          </div>
          <div class="block min-[440px]:hidden">Hello, I'm</div>
          <div class="block min-[440px]:hidden">
            <Name />
          </div>
        </h1>
        <p class="text-xl sm:text-2xl lg:text-4xl font-sans text-white mt-8">
          <span class="inline-flex items-center gap-2">
            Android Developer.
            <AndroidIcon aria-hidden="true" class="size-[1em] text-[#3DDC84]" />
          </span>
        </p>
      </div>

      <div class="grid lg:grid-rows-1 lg:grid-cols-3 gap-4 mt-20 animate-in fade-in slide-in-from-top-10 duration-1000">
        {links.map((link, index) => (
          <div class="group perspective-[1000px]">
            <a
              href={link.link}
              target="_blank"
              rel="noopener noreferrer"
              class={`w-full h-full block shadow-lg relative no-underline rounded-lg px-8 py-8 lg:py-24 text-white spotlight transform-3d group-hover:rotate-x-10 2xl:group-hover:rotate-x-5 duration-200 bg-linear-to-r ${linkBgColors[index]}`}
            >
              <div class="flex items-center">
                <div class="text-white uppercase text-2xl md:text-3xl xl:text-4xl tracking-wide font-mono">
                  {link.name}
                </div>
                <ExternalIcon
                  aria-hidden="true"
                  class="size-6 text-neutral-100/80 ml-1 sm:ml-2 invisible group-hover:visible"
                />
              </div>
              <div class="opacity-75 font-sans text-sm md:text-base">
                {link.description}
              </div>
            </a>
          </div>
        ))}
      </div>

      <div class="animate-in fade-in slide-in-from-top-6 duration-1000">
        <h2 class="mt-20 mb-4 text-2xl font-sans text-white">Skills</h2>
        <ul class="flex flex-wrap gap-2 sm:gap-3 text-white">
          {skills.map((skill, index) => (
            <li
              class="rounded-lg leading-5 font-mono uppercase text-sm md:text-base px-4 py-2 hover:scale-110 duration-200"
              style={{ backgroundColor: skillPillBgColors[index] }}
            >
              {skill}
            </li>
          ))}
        </ul>
      </div>

      <div class="animate-in fade-in slide-in-from-top-6 duration-1000">
        <h2 class="mt-20 mb-4 text-2xl font-sans text-white">Projects</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {projects.map((project, index) => (
            <button
              type="button"
              data-dialog={`project-${index}`}
              class="group perspective-[1000px] cursor-pointer text-left"
            >
              <div
                data-card
                class="spotlight relative w-full h-full shadow-lg rounded-lg overflow-hidden group-hover:rotate-x-10 2xl:group-hover:rotate-x-5 duration-200"
                style={{ backgroundColor: projectBgColors[index] }}
              >
                <Picture
                  src={project.image}
                  alt={project.name}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  layout="constrained"
                  width={800}
                  height={400}
                  fit="cover"
                  position="attention"
                  class="block aspect-2/1 w-full bg-neutral-500 object-cover brightness-50 transition-[filter] duration-300 group-hover:brightness-100 group-focus-visible:brightness-100"
                />
                <div data-card-text class="px-4 py-4">
                  <h3 class="text-lg uppercase font-mono font-medium text-white">
                    {project.name}
                  </h3>
                  <p class="text-sm font-sans font-light text-white leading-3">
                    {project.year}
                  </p>
                  <p class="mt-4 text-sm font-sans text-white/80">
                    {project.description}
                  </p>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>

      <div class="mt-20 flex">
        <a
          href="https://github.com/jacky-ttt/jacky-ttt.github.io/tree/dev"
          target="_blank"
          rel="noopener noreferrer"
          class="group mx-auto inline-flex items-center text-base sm:text-lg lg:text-xl no-underline rounded-lg text-white/80"
        >
          <GitHubIcon aria-hidden="true" class="inline size-[1em] mr-1" />
          Source
          <span class="ml-1 inline-flex w-0 overflow-hidden opacity-0 transition-all duration-200 group-hover:w-4 group-hover:opacity-100">
            <ExternalIcon aria-hidden="true" class="size-4 shrink-0" />
          </span>
        </a>
      </div>
    </div>
  </main>

  {/* Each dialog is the expanded form of its card: same colour, image on top, more detail. */}
  {projects.map((project, index) => (
    <dialog
      id={`project-${index}`}
      aria-labelledby={`project-${index}-title`}
      class="m-auto w-[calc(100%-2rem)] max-w-4xl flex-col overflow-hidden rounded-lg p-0 text-white shadow-2xl open:flex max-sm:m-0 max-sm:h-dvh max-sm:max-h-none max-sm:w-full max-sm:max-w-none max-sm:rounded-none"
      style={{ backgroundColor: projectBgColors[index] }}
    >
      <form method="dialog">
        <button
          data-close
          aria-label="Close"
          class="absolute top-4 right-4 z-10 flex size-12 items-center justify-center rounded-full bg-neutral-900/60 cursor-pointer"
        >
          <XMarkIcon aria-hidden="true" class="size-6 text-neutral-100/80" />
        </button>
      </form>
      {/* Image area takes the height left over and scrolls; the text below never shrinks. */}
      <div data-image class="min-h-0 shrink overflow-y-auto overscroll-contain">
        <Picture
          src={project.image}
          alt={project.name}
          formats={["avif"]}
          fallbackFormat="webp"
          layout="constrained"
          width={896}
          class="block w-full bg-neutral-500"
        />
      </div>
      <div class="max-h-[60dvh] shrink-0 overflow-y-auto px-6 py-6 sm:px-10 sm:py-8">
        <h3
          id={`project-${index}-title`}
          class="text-2xl sm:text-3xl uppercase font-mono font-medium"
        >
          {project.name}
        </h3>
        <p class="text-sm sm:text-base font-sans font-light text-white/80">
          {project.year}
        </p>
        <p class="mt-4 text-sm sm:text-base italic font-sans font-light text-white/80">
          {project.skill}
        </p>
        <p class="mt-4 text-base sm:text-lg font-sans">
          {project.fullDescription}
        </p>
      </div>
    </dialog>
  ))}
</Layout>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)")

  // Spotlight: feed the pointer position to the card's radial-gradient glow (global.css).
  document.addEventListener("pointermove", (event) => {
    const card = (event.target as Element).closest<HTMLElement>(".spotlight")
    if (!card) return
    const rect = card.getBoundingClientRect()
    card.style.setProperty("--spot-x", `${event.clientX - rect.left}px`)
    card.style.setProperty("--spot-y", `${event.clientY - rect.top}px`)
  })

  // Container transform: the whole card grows into its dialog (and shrinks back). Each pair is
  // [element before, element after, view-transition-name]; null means it only exists on one side.
  // Timings and which snapshots are drawn live in global.css under "Card -> dialog morph".
  type Pair = [HTMLElement | null, HTMLElement | null, string]
  const morph = (
    direction: "open" | "close",
    update: () => void,
    pairs: Pair[],
    color: string,
    done?: () => void,
  ) => {
    if (!document.startViewTransition || reduceMotion.matches) return update()
    const root = document.documentElement
    root.dataset.morph = direction
    root.style.setProperty("--morph-color", color)
    for (const [from, , name] of pairs)
      if (from) from.style.viewTransitionName = name
    const transition = document.startViewTransition(() => {
      for (const [from, to, name] of pairs) {
        if (from) from.style.viewTransitionName = ""
        if (to) to.style.viewTransitionName = name
      }
      update()
    })
    transition.finished.finally(() => {
      for (const [, to] of pairs) if (to) to.style.viewTransitionName = ""
      done?.()
      delete root.dataset.morph
    })
  }

  for (const button of document.querySelectorAll<HTMLElement>(
    "[data-dialog]",
  )) {
    const dialog = document.getElementById(
      button.dataset.dialog!,
    ) as HTMLDialogElement
    const card = button.querySelector<HTMLElement>("[data-card]")!
    const cardImage = card.querySelector("img")!
    // The scroll container, not the <img>: its snapshot is the visible, clipped part of a tall image.
    const dialogImage = dialog.querySelector<HTMLElement>("[data-image]")!
    const closeButton = dialog.querySelector<HTMLElement>("[data-close]")!
    const cardText = card.querySelector<HTMLElement>("[data-card-text]")!
    const color = card.style.backgroundColor
    cardText.addEventListener("animationend", () =>
      cardText.removeAttribute("data-enter"),
    )

    // While open, the card's grid slot stays in place but empty (data-expanded, global.css).
    const open = () =>
      morph(
        "open",
        () => {
          dialog.showModal()
          button.toggleAttribute("data-expanded", true)
          // Tall images scroll; start at the middle, where the brand/logo sits.
          dialogImage.scrollTop =
            (dialogImage.scrollHeight - dialogImage.clientHeight) / 2
        },
        [
          [card, dialog, "project-card"],
          [cardImage, dialogImage, "project-image"],
          [null, closeButton, "project-close"],
        ],
        color,
      )
    const close = () =>
      morph(
        "close",
        () => {
          dialog.close()
          button.removeAttribute("data-expanded")
        },
        [
          [dialog, card, "project-card"],
          [dialogImage, cardImage, "project-image"],
          [closeButton, null, "project-close"],
        ],
        color,
        // Once the box has landed, bring the small card's text in (fade + slide up).
        () => cardText.toggleAttribute("data-enter", true),
      )

    button.addEventListener("click", open)
    // Backdrop clicks land on the <dialog> itself.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close()
    })
    // The X button (form method="dialog") and Escape both close with the morph.
    dialog.querySelector("form")!.addEventListener("submit", (event) => {
      event.preventDefault()
      close()
    })
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault()
      close()
    })
  }
</script>
