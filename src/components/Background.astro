<!-- Dot grid that fades out from the top, with a soft violet glow behind the heading, and a brighter
     band of dots that sweeps down it on a loop. Pure CSS. -->
<div
  id="background"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10"
></div>

<style>
  #background {
    background: radial-gradient(
      50rem 32rem at 25% 0%,
      rgb(124 58 237 / 0.35),
      transparent 70%
    );
  }
  #background::before,
  #background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
        circle,
        rgb(255 255 255 / 0.22) 1px,
        transparent 1.5px
      )
      0 0 / 24px 24px;
    mask-image: radial-gradient(
      ellipse 80% 70% at 50% 0%,
      black 30%,
      transparent 100%
    );
  }
  /* The wave: the same dots, brighter, shown only inside a band that moves top to bottom. */
  #background::after {
    background-image: radial-gradient(
      circle,
      rgb(196 181 253 / 0.9) 1px,
      transparent 1.5px
    );
    mask-image:
      linear-gradient(
        transparent calc(var(--wave) - 10%),
        black var(--wave),
        transparent calc(var(--wave) + 10%)
      ),
      linear-gradient(black 40%, transparent);
    mask-composite: intersect;
    animation: dot-wave 6s linear infinite;
  }
  /* Band centre, registered so it can be animated. Starts and ends fully off screen. */
  @property --wave {
    syntax: "<percentage>";
    inherits: false;
    initial-value: -20%;
  }
  @keyframes dot-wave {
    from {
      --wave: -20%;
    }
    to {
      --wave: 120%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #background::after {
      display: none;
    }
  }
</style>
