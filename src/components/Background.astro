<!-- Dot grid that fades out from the top, with a soft violet glow behind the heading, and a brighter
     band of dots that sweeps down it on a loop. The button pauses the wave (WCAG 2.2.2); it's
     hidden under reduced motion, where there's no wave. -->
<div
  id="background"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10"
></div>
<button
  id="wave-toggle"
  type="button"
  class="fixed right-4 bottom-4 z-10 cursor-pointer rounded-full bg-neutral-900/80 px-3 py-1.5 font-mono text-xs uppercase tracking-wide text-white/90 motion-reduce:hidden"
>
  Pause animation
</button>

<style>
  #background {
    background: radial-gradient(
      50rem 32rem at 25% 0%,
      rgb(124 58 237 / 0.35),
      transparent 70%
    );
  }
  #background::before,
  #background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
        circle,
        rgb(255 255 255 / 0.22) 1px,
        transparent 1.5px
      )
      0 0 / 24px 24px;
    mask-image: radial-gradient(
      ellipse 80% 70% at 50% 0%,
      black 30%,
      transparent 100%
    );
  }
  /* The wave: the same dots, brighter, shown only inside a band that moves top to bottom. */
  #background::after {
    background-image: radial-gradient(
      circle,
      rgb(196 181 253 / 0.9) 1px,
      transparent 1.5px
    );
    mask-image:
      linear-gradient(
        transparent calc(var(--wave) - 10%),
        black var(--wave),
        transparent calc(var(--wave) + 10%)
      ),
      linear-gradient(black 40%, transparent);
    mask-composite: intersect;
    animation: dot-wave 6s linear infinite;
  }
  /* Band centre, registered so it can be animated. Starts and ends fully off screen. */
  @property --wave {
    syntax: "<percentage>";
    inherits: false;
    initial-value: -20%;
  }
  @keyframes dot-wave {
    from {
      --wave: -20%;
    }
    to {
      --wave: 120%;
    }
  }
  :global(html[data-paused]) #background::after {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    #background::after {
      display: none;
    }
  }
</style>

<script>
  // Remembered per visitor; storage can be unavailable (private mode), so it's best effort.
  const toggle = document.getElementById("wave-toggle")!
  const root = document.documentElement
  const render = () =>
    (toggle.textContent = root.hasAttribute("data-paused")
      ? "Play animation"
      : "Pause animation")
  try {
    if (localStorage.getItem("wave-paused"))
      root.toggleAttribute("data-paused", true)
  } catch {}
  render()
  toggle.addEventListener("click", () => {
    const paused = root.toggleAttribute("data-paused")
    try {
      if (paused) localStorage.setItem("wave-paused", "1")
      else localStorage.removeItem("wave-paused")
    } catch {}
    render()
  })
</script>
